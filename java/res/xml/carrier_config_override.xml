<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!-- This is a place for minor or overridden changes to internal carrier configuration values.
     The format and filtering rules are the same as those in carrier_config*.xml files.
     This file is read after any specific configuration file from the assets folder,
     so it must use explicit filters for MCC ad MNC if that is desired. -->
<carrier_config_list>
    <!-- Vodafone AU: do not gate incoming calls on a local bearer indication when
         the peer has not negotiated QoS preconditions. -->
    <carrier_config mcc="505" mnc="03">
        <boolean name="imsvoice.wait_qos_for_incoming_invite_without_precondition_bool"
                 value="false"/>
    </carrier_config>
</carrier_config_list>
